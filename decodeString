class Solution {
public:
    string decodeString(string s) {
        stack<int> numStk;
        stack<string> strStk;
        int sum = 0;
        string str="";

        for (int i=0;i<s.length();i++) {
            if (isdigit(s[i])) {
                sum = sum*10+(s[i]-'0');
            } else if (s[i] == '[') {
                numStk.push(sum);
                strStk.push(str);
                sum = 0;
                str = "";
            } else if (s[i] == ']') {
                string decodedStr = strStk.top();
                strStk.pop();
                int freq = numStk.top();
                numStk.pop();
                for (int j=0;j<freq;j++) {
                    decodedStr+=str;
                }
                str = decodedStr;
            } else {
                //concat string
                str+=s[i];
            }
        }
        return str;
    }
};
